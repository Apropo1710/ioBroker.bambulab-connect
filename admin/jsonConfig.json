{
    "i18n": true,
    "type": "panel",
    "items": {
        "discoveryIntro": {
            "type": "staticText",
            "text": "<div style=\"background:#eaf3fb;border-left:4px solid #1976d2;padding:10px 12px;border-radius:4px;\">Find BambuLab printers automatically on your local network. Save your current settings before scanning. Detected printers are added to the table without an Access Token; enter each Access Token manually.</div>",
            "format": "html"
        },
        "discoverPrinters": {
            "type": "sendTo",
            "command": "discoverPrinters",
            "label": "Search printers",
            "help": "Listen for local BambuLab SSDP/UDP announcements. This does not read or guess the LAN Access Token.",
            "showProcess": true,
            "timeout": 45000,
            "useNative": true,
            "icon": "search",
            "variant": "contained",
            "controlStyle": {
                "fontWeight": "bold",
                "fontSize": "0.875rem",
                "minHeight": "40px",
                "padding": "6px 12px",
                "backgroundColor": "#1976d2",
                "color": "#ffffff",
                "whiteSpace": "nowrap"
            },
            "xs": 6,
            "sm": 6,
            "md": 4,
            "doNotSave": false
        },
        "discoveryResultsTitle": {
            "type": "staticText",
            "text": "Discovery completed.",
            "hidden": "!Array.isArray(data.discoveryResults)",
            "xs": 12,
            "sm": 12
        },
        "discoveryResultsCopyHelp": {
            "type": "staticText",
            "text": "Copy the fields below into the existing printer table. Access tokens are never discovered.",
            "xs": 12,
            "sm": 12
        },
        "discoveryResultsEmpty": {
            "type": "staticText",
            "text": "No BambuLab printers found. Check that the printer and ioBroker are on the same LAN/VLAN and that UDP discovery traffic is allowed.",
            "hidden": "!Array.isArray(data.discoveryResults) || data.discoveryResults.length !== 0",
            "xs": 12,
            "sm": 12
        },
        "discoveryResultsOverflow": {
            "type": "staticText",
            "text": "More than 8 printers were detected. The first 8 are displayed here.",
            "hidden": "!Array.isArray(data.discoveryResults) || data.discoveryResults.length <= 8",
            "xs": 12,
            "sm": 12
        },
        "discoveryPrinter0Title": {
            "type": "staticText",
            "text": "Printer 1",
            "hidden": "!Array.isArray(data.discoveryResults) || data.discoveryResults.length <= 0",
            "xs": 12,
            "sm": 12
        },
        "discoveryPrinter0name": {
            "type": "pattern",
            "label": "Name",
            "pattern": "${data.discoveryResults?.[0]?.name || ''}",
            "copyToClipboard": true,
            "hidden": "!Array.isArray(data.discoveryResults) || data.discoveryResults.length <= 0",
            "xs": 12,
            "sm": 6
        },
        "discoveryPrinter0ip": {
            "type": "pattern",
            "label": "IP address",
            "pattern": "${data.discoveryResults?.[0]?.ip || ''}",
            "copyToClipboard": true,
            "hidden": "!Array.isArray(data.discoveryResults) || data.discoveryResults.length <= 0",
            "xs": 12,
            "sm": 6
        },
        "discoveryPrinter0serial": {
            "type": "pattern",
            "label": "Serial number",
            "pattern": "${data.discoveryResults?.[0]?.serial || ''}",
            "copyToClipboard": true,
            "hidden": "!Array.isArray(data.discoveryResults) || data.discoveryResults.length <= 0",
            "xs": 12,
            "sm": 6
        },
        "discoveryPrinter0model": {
            "type": "pattern",
            "label": "Model",
            "pattern": "${data.discoveryResults?.[0]?.model || ''}",
            "copyToClipboard": true,
            "hidden": "!Array.isArray(data.discoveryResults) || data.discoveryResults.length <= 0",
            "xs": 12,
            "sm": 6
        },
        "discoveryPrinter0Configured": {
            "type": "staticText",
            "text": "Already configured",
            "hidden": "!Array.isArray(data.discoveryResults) || !data.discoveryResults?.[0]?.configured",
            "xs": 12,
            "sm": 12
        },
        "discoveryPrinter0Divider": {
            "type": "divider",
            "height": 3,
            "color": "primary",
            "hidden": "!Array.isArray(data.discoveryResults) || data.discoveryResults.length <= 1"
