{
    "i18n": true,
    "type": "panel",
    "items": {
        "discoveryIntro": {
            "type": "staticText",
            "text": "Find BambuLab printers automatically on your local network. Save your current settings before scanning. Detected printers are added to the table without an Access Token; enter each Access Token manually."
        },
        "discoverPrinters": {
            "type": "sendTo",
            "command": "discoverPrinters",
            "label": "Search for BambuLab printers",
            "help": "Listen for local BambuLab SSDP/UDP announcements. This does not read or guess the LAN Access Token.",
            "showProcess": true,
            "timeout": 45000,
            "useNative": true,
            "icon": "search",
            "variant": "contained",
            "controlStyle": {
                "fontWeight": "bold",
                "fontSize": "1rem",
                "minHeight": "48px",
                "padding": "10px 24px"
            },
            "xs": 12,
            "sm": 12
        },
        "discoveryResultsTitle": {
            "type": "staticText",
            "text": "Discovery completed: ${data.discoveryResults?.length || 0} BambuLab printer(s) found. Copy the fields below into the existing printer table. Access tokens are never discovered.",
            "noTranslation": true,
            "hidden": "!Array.isArray(data.discoveryResults)",
            "xs": 12,
            "sm": 12
        },
        "discoveryResultsEmpty": {
            "type": "staticText",
            "text": "No BambuLab printers found. Check that the printer and ioBroker are on the same LAN/VLAN and that UDP discovery traffic is allowed.",
            "noTranslation": true,
            "hidden": "!Array.isArray(data.discoveryResults) || data.discoveryResults.length !== 0",
            "xs": 12,
            "sm": 12
        },
        "discoveryResultsOverflow": {
            "type": "staticText",
            "text": "More than 8 printers were detected. The first 8 are displayed here.",
            "noTranslation": true,
            "hidden": "!Array.isArray(data.discoveryResults) || data.discoveryResults.length <= 8",
            "xs": 12,
            "sm": 12
        },
        "discoveryPrinter0Title": {
            "type": "staticText",
            "text": "Printer 1: ${data.discoveryResults?.[0]?.name || data.discoveryResults?.[0]?.model || 'BambuLab printer'}${data.discoveryResults?.[0]?.configured ? ' (already configured)' : ''}",
            "noTranslation": true,
            "hidden": "!Array.isArray(data.discoveryResults) || data.discoveryResults.length <= 0",
            "xs": 12,
            "sm": 12
        },
        "discoveryPrinter0name": {
            "type": "pattern",
            "label": "Name",
            "pattern": "${data.discoveryResults?.[0]?.name || ''}",
            "copyToClipboard": true,
            "noTranslation": true,
            "hidden": "!Array.isArray(data.discoveryResults) || data.discoveryResults.length <= 0",
            "xs": 12,
            "sm": 6
        },
        "discoveryPrinter0ip": {
            "type": "pattern",
            "label": "IP address",
            "pattern": "${data.discoveryResults?.[0]?.ip || ''}",
            "copyToClipboard": true,
            "noTranslation": true,
            "hidden": "!Array.isArray(data.discoveryResults) || data.discoveryResults.length <= 0",
            "xs": 12,
            "sm": 6
        },
        "discoveryPrinter0serial": {
            "type": "pattern",
            "label": "Serial number",
            "pattern": "${data.discoveryResults?.[0]?.serial || ''}",
            "copyToClipboard": true,
            "noTranslation": true,
            "hidden": "!Array.isArray(data.discoveryResults) || data.discoveryResults.length <= 0",
            "xs": 12,
            "sm": 6
        },
        "discoveryPrinter0model": {
            "type": "pattern",
            "label": "Model",
            "pattern": "${data.discoveryResults?.[0]?.model || ''}",
            "copyToClipboard": true,
            "noTranslation": true,
            "hidden": "!Array.isArray(data.discoveryResults) || data.discoveryResults.length <= 0",
            "xs": 12,
            "sm": 6
        },
