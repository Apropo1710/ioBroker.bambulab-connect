{
    "i18n": true,
    "type": "panel",
    "items": {
        "discoveryIntro": {
            "type": "staticText",
            "text": "<div style=\"background:#eaf3fb;border-left:4px solid #1976d2;padding:10px 12px;border-radius:4px;\">Find BambuLab printers automatically on your local network. The results appear below the button and do not change your configuration. Click a value to select it, copy it and paste it into a new row of the printer table and enter each Access Token manually.</div>",
            "format": "html"
        },
        "discoverPrinters": {
            "type": "sendTo",
            "command": "discoverPrinters",
            "label": "Search printers",
            "help": "Listen for local BambuLab SSDP/UDP announcements. This does not read or guess the LAN Access Token.",
            "showProcess": true,
            "timeout": 45000,
            "icon": "search",
            "variant": "contained",
            "controlStyle": {
                "fontWeight": "bold",
                "fontSize": "0.875rem",
                "minHeight": "40px",
                "padding": "6px 12px",
                "backgroundColor": "#1976d2",
                "color": "#ffffff",
                "whiteSpace": "nowrap"
            },
            "xs": 6,
            "sm": 6,
            "md": 4,
            "doNotSave": false
        },
        "_discoveryResults": {
            "type": "state",
            "oid": "discovery.results",
            "control": "html",
            "xs": 12,
            "sm": 12
        },
        "configuredPrintersDivider": {
            "type": "divider",
            "height": 3,
            "color": "primary"
        },
        "configuredPrintersHeader": {
            "type": "header",
            "text": "Configured printers",
            "size": 3
        },
        "printers": {
            "type": "table",
            "label": "BambuLab printers",
            "help": "Add one row for each printer. All printers are managed independently by this adapter instance.",
            "titleAttribute": "name",
            "items": [
                {
                    "attr": "name",
                    "type": "text",
                    "title": "Printer name",
                    "width": "20%",
                    "default": ""
                },
                {
                    "attr": "host",
                    "type": "text",
                    "title": "IP address",
                    "width": "15%",
                    "default": ""
                },
                {
                    "attr": "serial",
                    "type": "text",
                    "title": "Serial number",
                    "width": "18%",
                    "default": ""
                },
                {
                    "attr": "Password",
                    "type": "password",
                    "title": "Access token",
                    "width": "15%",
                    "default": ""
                },
                {
                    "attr": "printerModel",
                    "type": "select",
                    "title": "Model",
                    "width": "15%",
                    "default": "P1-Series",
                    "options": [
                        {
                            "label": "A1 mini",
                            "value": "A1 mini"
                        },
                        {
                            "label": "A1",
                            "value": "A1"
                        },
                        {
                            "label": "A2L (experimental)",
                            "value": "A2L"
                        },
                        {
                            "label": "P1P",
                            "value": "P1P"
                        },
                        {
                            "label": "P1S",
                            "value": "P1S"
                        },
                        {
                            "label": "P2S (experimental)",
                            "value": "P2S"
                        },
                        {
                            "label": "X1",
                            "value": "X1"
                        },
                        {
                            "label": "X1 Carbon (X1C)",
                            "value": "X1C"
                        },
                        {
                            "label": "X1E",
                            "value": "X1E"
                        },
                        {
                            "label": "X2D (experimental)",
                            "value": "X2D"
                        },
                        {
                            "label": "H2D",
                            "value": "H2D"
                        },
                        {
                            "label": "H2D Pro (experimental)",
                            "value": "H2D Pro"
                        },
                        {
                            "label": "H2S (experimental)",
                            "value": "H2S"
                        },
                        {
                            "label": "H2C (experimental)",
                            "value": "H2C"
                        },
                        {
                            "label": "H3C (experimental)",
                            "value": "H3C"
                        }
                    ]
                },
                {
                    "attr": "requestInterval",
                    "type": "number",
                    "title": "Polling interval (s)",
                    "width": "12%",
                    "default": 300,
                    "min": 60,
                    "max": 36000
                }
            ]
        }
    }
}
