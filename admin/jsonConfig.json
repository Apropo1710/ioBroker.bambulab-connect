{
    "i18n": true,
    "type": "panel",
    "items": {
        "discoveryIntro": {
            "type": "staticText",
            "text": "Find BambuLab printers automatically on your local network. Save your current settings before scanning. Detected printers are added to the table without an access code; enter each code manually."
        },
        "discoverPrinters": {
            "type": "sendTo",
            "command": "discoverPrinters",
            "label": "Search for BambuLab printers",
            "help": "Listen for local BambuLab SSDP/UDP announcements. This does not read or guess the LAN access code.",
            "showProcess": true,
            "timeout": 45000,
            "useNative": true,
            "icon": "search"
        },
        "discoveryResults": {
            "type": "textSendTo",
            "command": "getDiscoveryResult",
            "label": "Last network scan",
            "container": "div",
            "copyToClipboard": true
        },
        "printers": {
            "type": "table",
            "label": "BambuLab printers",
            "help": "Add one row for each printer. All printers are managed independently by this adapter instance.",
            "titleAttribute": "name",
            "items": [
                {
                    "attr": "name",
                    "type": "text",
                    "title": "Printer name",
                    "width": "20%",
                    "default": ""
                },
                {
                    "attr": "host",
                    "type": "text",
                    "title": "IP address",
                    "width": "15%",
                    "default": ""
                },
                {
                    "attr": "serial",
                    "type": "text",
                    "title": "Serial number",
                    "width": "18%",
                    "default": ""
                },
                {
                    "attr": "Password",
                    "type": "password",
                    "title": "Access token",
                    "width": "15%",
                    "default": ""
                },
                {
                    "attr": "printerModel",
                    "type": "select",
                    "title": "Model",
                    "width": "15%",
                    "default": "P1-Series",
                    "options": [
                        {
                            "label": "A1 mini",
                            "value": "A1 mini"
                        },
                        {
                            "label": "A1",
                            "value": "A1"
                        },
                        {
                            "label": "A2L (experimental)",
                            "value": "A2L"
                        },
                        {
                            "label": "P1P",
                            "value": "P1P"
                        },
                        {
                            "label": "P1S",
                            "value": "P1S"
                        },
                        {
                            "label": "P2S (experimental)",
                            "value": "P2S"
                        },
                        {
                            "label": "X1",
                            "value": "X1"
                        },
                        {
                            "label": "X1 Carbon (X1C)",
                            "value": "X1C"
                        },
                        {
                            "label": "X1E",
                            "value": "X1E"
                        },
                        {
                            "label": "X2D (experimental)",
                            "value": "X2D"
                        },
                        {
                            "label": "H2D",
                            "value": "H2D"
                        },
                        {
                            "label": "H2D Pro (experimental)",
                            "value": "H2D Pro"
                        },
                        {
                            "label": "H2S (experimental)",
                            "value": "H2S"
                        },
                        {
                            "label": "H2C (experimental)",
                            "value": "H2C"
                        },
                        {
                            "label": "H3C (experimental)",
                            "value": "H3C"
                        }
                    ]
                },
                {
                    "attr": "requestInterval",
                    "type": "number",
                    "title": "Polling interval (s)",
                    "width": "12%",
                    "default": 300,
                    "min": 60,
                    "max": 36000
                }
            ]
        },
        "getDataFiles": {
            "newLine": true,
            "type": "fileSelector",
            "upload": "/",
            "label": "Upload g-code file",
            "help": "Select a file to upload to the ioBroker file storage.",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        }
    }
}
